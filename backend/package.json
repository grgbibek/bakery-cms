{
  "name": "bakery-cms-backend",
  "version": "1.0.0",
  "description": "Backend API for Bakery CMS",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:prod": "node dist/index.js",
    "dev": "node --watch server.js",
